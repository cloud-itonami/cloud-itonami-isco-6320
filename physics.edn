;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a farm-logistics robot performs feeding-schedule
;; and animal-condition check-in data entry, household task scheduling and
;; feed/supplies procurement coordination for subsistence livestock farmers
;; (ISCO 6320). It never handles animals. Its physical work is supply
;; logistics: hauling purchased feed from the village road to the household
;; feed store over a dirt path, and tipping a feed sack into the store bin.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6320"
 :cases
 [{:id :feed-road-to-household-store
   :kind :transport
   :procedure "logistics robot hauls purchased feed sacks along a dirt path from the village road to the household feed store"
   :params {:mass-kg 60.0 :payload-kg 50.0 :v-max-mps 0.8 :a-max-mps2 0.25
            :brake-decel-mps2 0.5 :drive-force-n 150.0 :crr 0.07
            :cog-height-m 0.45 :support-half-length-m 0.30 :max-time-s 3000.0}
   :sweep {:param :distance-m :values [50.0 150.0 300.0 500.0 800.0]}
   :quantity :cycle-time-s
   :limit {:max 600.0 :basis "estimate: one haul within 10 minutes so the delivery is stored before the next feeding round"}
   :boundary {:lo 10.0 :hi 2000.0}}
  {:id :feed-sack-into-store-bin
   :kind :manipulator
   :procedure "arm lifts a feed sack from the robot's deck up over the rim of the household feed-store bin"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.5
            :from [0.60 0.10] :to [0.30 0.85] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [5.0 10.0 15.0 20.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a ~15-20 kg payload class arm"}
   :boundary {:lo 1.0 :hi 50.0}}]}
